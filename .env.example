PORT=8787
HOST=127.0.0.1
DATABASE_PATH=agent-trust.db

# Replace both before any shared deployment.
BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-secret
APPROVAL_TOKEN=replace-with-a-random-approval-secret

# Application Default Credentials remain server-side.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/application-default-credentials.json

# Full Google Model Armor sanitizeUserPrompt endpoint for your template.
# MODEL_ARMOR_ENDPOINT=https://modelarmor.LOCATION.rep.googleapis.com/v1/projects/PROJECT/locations/LOCATION/templates/TEMPLATE:sanitizeUserPrompt

PUBLIC_URL=http://localhost:8787
